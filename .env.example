PORT=3000
NODE_ENV=development

# Firebase Auth project used to validate client ID tokens.
FIREBASE_PROJECT_ID=innovationtech-6e205

# Stripe keys. Use test keys first, then live keys in production.
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET_KEY

# Optional. Comma-separated allowed frontend origins for API requests.
# Leave empty when serving the frontend from the same backend.
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
